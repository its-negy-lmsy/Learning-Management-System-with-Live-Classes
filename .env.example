NODE_ENV=development
PORT=4100
WEB_ORIGIN=http://localhost:5174
DEMO_MODE=true
MONGODB_URI=mongodb://127.0.0.1:27017/fs03
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
UPLOAD_MAX_MB=500
MEDIA_ROOT=./storage
MEDIA_STORAGE=local
REDIS_URL=

# Optional private S3 and CloudFront delivery
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

# Optional LiveKit and payment-provider configuration
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_PROVIDER=mock

# Development-only seeded learner/instructor accounts. Never reuse in production.
SEED_DEMO=true
DEMO_STUDENT_EMAIL=learner@fs03.demo
DEMO_STUDENT_PASSWORD=LearnFS03!Local
DEMO_INSTRUCTOR_EMAIL=teacher@fs03.demo
DEMO_INSTRUCTOR_PASSWORD=TeachFS03!Local
# Admin creation requires an explicitly supplied bootstrap password.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
